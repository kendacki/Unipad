# Shared
DATABASE_URL=postgres://unipad:unipad@localhost:5432/unipad
REDIS_URL=redis://localhost:6379

# API
PORT=8787
JWT_SECRET=dev-only-change-me-unipad
AUTH_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:3000
# UCT treasury (Sphere principal / nametag that receives mint payments)
TREASURY_PRINCIPAL=@unipad
# Platform fee in basis points (250 = 2.5%)
PLATFORM_FEE_BPS=250
# Concurrent mint settlements (admission queue)
MINT_CONCURRENCY=8
# Stricter creator console rate limit (audit S-10)
CREATOR_RATE_LIMIT_STRICT=true
CREATOR_RATE_LIMIT_PER_MIN=30
# Application-layer buckets (Redis-backed when REDIS_URL is up)
GLOBAL_RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=20
PUBLIC_API_URL=http://localhost:8787
# Behind nginx edge LB (docker compose --profile edge): PUBLIC_API_URL=http://localhost:8080
# Allow mock UCT settlement on the API for local testing (web UI is Sphere-only)
UNIPAD_DEV_MOCK=true
# UCT has 18 decimals (Unicity registry); amounts in API are decimal strings of base units
UCT_DECIMALS=18
# Canonical UCT coin id (64-hex) — from unicity-ids testnet registry
NEXT_PUBLIC_UCT_COIN_ID=455ad8720656b08e8dbd5bac1f3c73eeea5431565f6c1c3af742b1aa12d41d89

# Web
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787
NEXT_PUBLIC_SPHERE_WALLET_URL=https://sphere.unicity.network
# Sphere popup is blocked on localhost by CloudFront — use Sphere extension or public HTTPS
NEXT_PUBLIC_NETWORK=testnet2

# --- Vercel production (set in Project → Settings → Environment Variables) ---
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# NEXT_PUBLIC_API_URL=https://your-api.example.com
# NEXT_PUBLIC_WS_URL=wss://your-api.example.com
